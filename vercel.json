{
  "regions": ["fra1"],
  "functions": { "api/sample.ts": { "maxDuration": 300 } },
  "headers": [
    { "source": "/(.*)\\.js", "headers": [{ "key": "content-type", "value": "text/javascript; charset=utf-8" }] },
    { "source": "/(.*)\\.webmanifest", "headers": [{ "key": "content-type", "value": "application/manifest+json; charset=utf-8" }] }
  ]
}
